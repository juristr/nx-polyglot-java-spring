{
  "name": "@shop/storefront-products",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@shop/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@shop/api-types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "nx": {
    "name": "storefront-products",
    "tags": [
      "type:feature",
      "scope:web"
    ],
    "targets": {
      "typecheck": {
        "options": {
          "command": "tsc -p tsconfig.typecheck.json"
        },
        "inputs": [
          "default",
          {
            "input": "default",
            "projects": [
              "api-types"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/*.ts",
            "transitive": true
          },
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "outputs": []
      }
    }
  }
}
