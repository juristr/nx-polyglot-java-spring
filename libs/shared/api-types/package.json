{
  "name": "@shop/api-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@shop/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "codegen": "openapi-ts -i ../../../apps/products-api/build/openapi/openapi.json -o src/generated -p @hey-api/typescript"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0"
  },
  "nx": {
    "name": "api-types",
    "tags": [
      "type:types",
      "scope:shared"
    ],
    "implicitDependencies": [
      "products-api"
    ],
    "targets": {
      "codegen": {
        "dependsOn": [
          "^generateOpenApi"
        ],
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/build/openapi/openapi.json"
          },
          "{projectRoot}/package.json",
          "sharedGlobals"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true
      }
    }
  }
}
