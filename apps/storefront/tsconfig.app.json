{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "customConditions": ["@shop/source"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    /* Typecheck through `tsc --build`, which Nx infers as the typecheck target */
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "references": [
    {
      "path": "../../libs/shared/api-types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/storefront/products/tsconfig.lib.json"
    },
    {
      "path": "../../libs/storefront/orders/tsconfig.lib.json"
    }
  ]
}
